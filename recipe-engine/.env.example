# MealVista Recipe Engine - Runtime AI recipes (like GPT)

# Gemini (optional). Free tier: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (optional fallback when Gemini quota exceeded). Free tier, cloud – no load on your laptop: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# USDA FoodData Central (optional). Same type of data as MyFitnessPal. Free key: https://fdc.nal.usda.gov/api-key-signup
# When set, unknown ingredients are looked up in USDA for accurate kcal/macros per 100g.
USDA_API_KEY=your_usda_api_key_here
